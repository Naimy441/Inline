# Copy to .env.local to enable model responses.
# Without OPENAI_API_KEY, Chat uses a local mock so you can still
# exercise selection context and the keep/undo loop.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-nano
ANTHROPIC_API_KEY=

# Web research. First configured provider wins; DuckDuckGo is the no-key fallback.
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=
EXA_API_KEY=
# INLINE_DISABLE_WEB=1
